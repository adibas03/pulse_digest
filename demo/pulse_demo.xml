<?xml version="1.0" encoding="utf-8"?>
<!--
  Pulse — Demo data

  Loaded when the database is created with demo data enabled (Odoo's
  default). Produces a working, runnable Pulse setup so that a developer
  who just installed the module can trigger a digest from the Run wizard
  immediately, without first doing 5 minutes of configuration.

  noupdate="1" so demo data doesn't churn on module updates — once
  installed, it stays as a stable example.

  What this creates:
    1. A pulse.config for the main company, scheduled at 07:00, "both"
       digest mode (company-wide + per-user).
    2. The four default-enabled detectors linked and active. The other
       two (statistical) are linked but inactive, so a reviewer browsing
       the config sees the full catalog and the enable-by-default vs
       opt-in distinction.
    3. admin user added as the company digest recipient.
    4. The standard demo user (Marc Demo) granted Recipient access, so a
       reviewer logged in as demo sees Pulse runs/findings without needing
       admin.
    5. The Recipient group set as recipient_group_ids, so every run —
       company-wide or per-user alike — also forwards to that group's
       current members. In this demo, that's admin (implied via the
       Administrator group) and Marc Demo, demonstrating group-based
       forwarding distinct from admin's individual company_recipient_ids
       listing above.
-->
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Demo user access                                             -->
        <!-- ============================================================ -->

        <!-- Grants the standard Odoo demo user (Marc Demo) recipient access
             so a reviewer logged in as demo can see Pulse runs/findings
             without needing admin. -->

        <record id="base.user_demo" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_pulse_recipient'))]" />
        </record>

        <!-- ============================================================ -->
        <!-- Demo Pulse config                                            -->
        <!-- ============================================================ -->

        <record id="demo_pulse_config_main" model="pulse.config">
            <field name="name">Daily Pulse</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active" eval="True"/>
            <field name="run_time">7.0</field>
            <field name="digest_mode">both</field>
            <field name="company_recipient_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
            <field name="user_group_id" ref="group_pulse_recipient"/>
            <field name="recipient_group_ids" eval="[(6, 0, [ref('group_pulse_recipient')])]"/>
        </record>

        <!-- ============================================================ -->
        <!-- Activated detectors (defaults-on)                            -->
        <!-- ============================================================ -->

        <record id="demo_config_detector_overdue" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_account_overdue_invoices"/>
            <field name="active" eval="True"/>
        </record>

        <record id="demo_config_detector_credit_limit" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_account_credit_limit_breach"/>
            <field name="active" eval="True"/>
        </record>

        <record id="demo_config_detector_stale_opps" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_sale_stale_opportunities"/>
            <field name="active" eval="True"/>
        </record>

        <record id="demo_config_detector_closing_today" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_sale_deals_closing_today"/>
            <field name="active" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- Linked-but-inactive detectors (statistical, opt-in)          -->
        <!--                                                              -->
        <!-- Linked so they show in the config UI with an enable toggle,  -->
        <!-- demonstrating the "Conservative defaults, statistical ones   -->
        <!-- visible but off" UX from the spec.                           -->
        <!-- ============================================================ -->

        <record id="demo_config_detector_payment_outlier" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_account_payment_delay_outlier"/>
            <field name="active" eval="False"/>
        </record>

        <record id="demo_config_detector_velocity" model="pulse.config.detector">
            <field name="config_id" ref="demo_pulse_config_main"/>
            <field name="detector_id" ref="detector_sale_deal_velocity_drop"/>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
